diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -339,6 +339,9 @@ add_executable(airplay-windows
     src/usb/pair_record.cpp
     src/usb/usb_supervisor.cpp
 )
+if(WIN32)
+    target_sources(airplay-windows PRIVATE src/airplay-windows.rc)
+endif()
 
 target_include_directories(airplay-windows PRIVATE src)
 target_link_libraries(airplay-windows PRIVATE OpenSSL::Crypto ${FFMPEG_TARGETS} ${SDL2_TARGET} ${SDL2_TTF_TARGET} imgui)
diff --git a/src/airplay-windows.rc b/src/airplay-windows.rc
new file mode 100644
--- /dev/null
+++ b/src/airplay-windows.rc
@@ -0,0 +1,3 @@
+#include <windows.h>
+
+1 ICON "macast.ico"
diff --git a/src/video/video_renderer.cpp b/src/video/video_renderer.cpp
--- a/src/video/video_renderer.cpp
+++ b/src/video/video_renderer.cpp
@@ -820,9 +820,35 @@ void VideoRenderer::run(const std::string& title) {
 #if defined(_WIN32)
     SDL_SysWMinfo instance_window_info{};
     SDL_VERSION(&instance_window_info.version);
-    if (SDL_GetWindowWMInfo(window, &instance_window_info))
-        SetPropW(instance_window_info.info.win.window,
-                 ap::platform::kInstanceWindowProperty, reinterpret_cast<HANDLE>(1));
+    if (SDL_GetWindowWMInfo(window, &instance_window_info)) {
+        HWND hwnd = instance_window_info.info.win.window;
+        SetPropW(hwnd, ap::platform::kInstanceWindowProperty,
+                 reinterpret_cast<HANDLE>(1));
+
+        // Resource ID 1 is the Macast icon embedded by airplay-windows.rc.
+        HICON large_icon = static_cast<HICON>(LoadImageW(
+            GetModuleHandleW(nullptr), MAKEINTRESOURCEW(1), IMAGE_ICON,
+            GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON),
+            LR_DEFAULTCOLOR | LR_SHARED));
+        HICON small_icon = static_cast<HICON>(LoadImageW(
+            GetModuleHandleW(nullptr), MAKEINTRESOURCEW(1), IMAGE_ICON,
+            GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON),
+            LR_DEFAULTCOLOR | LR_SHARED));
+        if (large_icon) {
+            SendMessageW(hwnd, WM_SETICON, ICON_BIG,
+                         reinterpret_cast<LPARAM>(large_icon));
+            SetClassLongPtrW(hwnd, GCLP_HICON,
+                             reinterpret_cast<LONG_PTR>(large_icon));
+        }
+        if (small_icon) {
+            SendMessageW(hwnd, WM_SETICON, ICON_SMALL,
+                         reinterpret_cast<LPARAM>(small_icon));
+            SetClassLongPtrW(hwnd, GCLP_HICONSM,
+                             reinterpret_cast<LONG_PTR>(small_icon));
+        }
+    }
 #endif
     gpu_video.init(renderer);
     {

+void test_preemption_keeps_newest_client() {
+    ap::net::TcpServer server;
+    std::mutex sockets_mutex;
+    std::condition_variable sockets_cv;
+    std::vector<socket_t> server_sockets;
+    std::atomic<int> cleaned{0};
+    require(server.start(0, [&](ap::net::ClientSocket client) {
+        {
+            std::lock_guard<std::mutex> lock(sockets_mutex);
+            server_sockets.push_back(client.fd);
+            sockets_cv.notify_all();
+        }
+        ap::airplay::RequestReader reader(client.cancelled);
+        ap::airplay::Request request;
+        while (reader.read(client.fd, request)) {
+            require(ap::net::send_all(client.fd, "OK\n", 3) == 3,
+                    "kept peer response");
+        }
+        ++cleaned;
+    }), "preemption server start");
+
+    auto older = connect_to(server.port());
+    wait_for([&] {
+        std::lock_guard<std::mutex> lock(sockets_mutex);
+        return server_sockets.size() == 1;
+    });
+    auto newest = connect_to(server.port());
+    wait_for([&] {
+        std::lock_guard<std::mutex> lock(sockets_mutex);
+        return server_sockets.size() == 2;
+    });
+
+    socket_t keep_fd;
+    {
+        std::lock_guard<std::mutex> lock(sockets_mutex);
+        keep_fd = server_sockets[1];
+    }
+    bool drained = false;
+    server.close_clients_except(keep_fd, [&] {
+        require(cleaned == 1,
+                "older client teardown completes before preemption callback");
+        drained = true;
+    });
+    require(drained, "preemption drain callback");
+    check_closed(older);
+
+    const std::string request =
+        "OPTIONS / RTSP/1.0\r\nContent-Length: 0\r\n\r\n";
+    require(ap::net::send_all(
+                newest, request.data(), static_cast<int>(request.size())) > 0,
+            "newest client survives preemption");
+    char reply[3];
+    require(ap::net::recv_all(newest, reply, 3) == 3,
+            "newest client remains usable");
+
+    server.stop();
+    check_closed(newest);
+    require(cleaned == 2, "all preemption workers are joined");
+    std::cout << "PASS: newest client preempts and drains older peer\n";
+}

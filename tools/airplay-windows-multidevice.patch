+void WINAPI resolve_callback(
+    DWORD status, PVOID context, PDNS_SERVICE_INSTANCE instance) {
+    auto* state = static_cast<ResolveState*>(context);
+    std::wstring host;
+    IP4_ADDRESS ipv4{};
+    WORD port = 0;
+    const bool has_ipv4 =
+        instance && instance->ip4Address != nullptr;
+    if (instance) {
+        if (instance->pszHostName) host = instance->pszHostName;
+        port = instance->wPort;
+        if (has_ipv4) ipv4 = *instance->ip4Address;
+        DnsServiceFreeInstance(instance);
+    }
+    {
+        std::lock_guard<std::mutex> lock(state->mutex);
+        state->status = status;
+        state->host = std::move(host);
+        state->ipv4 = ipv4;
+        state->port = port;
+        state->has_ipv4 = has_ipv4;
+        state->completed = true;
+    }
+    state->cv.notify_all();
+}
+
 } // namespace
 

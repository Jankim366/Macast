 namespace ap::mdns {
 
+namespace {
+
+std::string identity_suffix(const ap::airplay::DeviceContext& ctx) {
+    std::string hex;
+    hex.reserve(ctx.deviceid.size());
+    for (char c : ctx.deviceid) {
+        if ((c >= '0' && c <= '9') ||
+            (c >= 'a' && c <= 'f') ||
+            (c >= 'A' && c <= 'F')) {
+            hex.push_back(c);
+        }
+    }
+    if (hex.size() < 6) return "000000";
+    return hex.substr(hex.size() - 6);
+}
+
+} // namespace
+
+std::string airplay_instance_label(
+    const ap::airplay::DeviceContext& ctx) {
+    return ctx.name + " [" + identity_suffix(ctx) + "]";
+}
+

diff --git a/src/net/tcp_server.cpp b/src/net/tcp_server.cpp
index dfda525..bb04ad8 100644
--- a/src/net/tcp_server.cpp
+++ b/src/net/tcp_server.cpp
@@ -204,4 +204,30 @@ void TcpServer::close_all_clients(const std::function<void()>& on_drained) {
     disconnecting_ = false;
 }
 
+void TcpServer::close_clients_except(
+        socket_t keep_fd, const std::function<void()>& on_drained) {
+    std::unique_lock<std::mutex> lock(clients_mtx_);
+    disconnecting_ = true;
+    std::size_t closed = 0;
+    for (const auto& [fd, cancelled] : active_clients_) {
+        if (fd == keep_fd) continue;
+        cancelled->store(true);
+#if defined(_WIN32)
+        ::shutdown(fd, SD_BOTH);
+#else
+        ::shutdown(fd, SHUT_RDWR);
+#endif
+        ++closed;
+    }
+    LOG_INFO << "TCP server: preempting " << closed
+             << " older client(s); keeping fd=" << keep_fd;
+    clients_cv_.wait(lock, [this, keep_fd] {
+        const auto keep_count = active_clients_.count(keep_fd);
+        return active_clients_.size() <=
+            static_cast<std::size_t>(keep_count ? 1 : 0);
+    });
+    if (on_drained) on_drained();
+    disconnecting_ = false;
+}
+
 } // namespace ap::net
